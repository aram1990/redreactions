{
  "_comment": "dryRun/live/active state lives ONLY in pilot.json — that is the single source of truth. There is deliberately no duplicate flag here.",
  "maxAutoPublish": 10,
  "pilotDurationHours": 24,
  "candidateMaxAgeHours": 72,
  "seenRetentionDays": 45,
  "logRetentionDays": 45,
  "claudeCommand": "claude",
  "claudeEvaluatorArgs": ["-p", "--permission-mode", "plan"],
  "claudePublisherArgs": ["-p", "--permission-mode", "acceptEdits"],
  "claudeTimeoutSeconds": 1800,
  "publisherTimeoutSeconds": 2700,
  "buildCommand": "npm",
  "buildArgs": ["run", "build"],
  "productionUrlBase": "https://redreactions.com",
  "deployWaitSeconds": 90,
  "deployPollIntervalSeconds": 15,
  "httpTimeoutSeconds": 20,
  "userAgent": "RedReactionsWatch/1.0 (+https://redreactions.com)"
}
