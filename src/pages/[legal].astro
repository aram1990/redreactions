---
import BaseLayout from '../layouts/BaseLayout.astro';
const documents={privacy:{title:'Privacy Policy',intro:'This template explains the information practices that the owner must complete before launch.'},cookies:{title:'Cookie Policy',intro:'This template should be completed after the site owner selects a consent platform and advertising configuration.'},terms:{title:'Terms of Use',intro:'This template sets out terms that need owner and jurisdiction-specific review before launch.'},'editorial-policy':{title:'Editorial Policy',intro:'Red Reactions aims for original commentary, transparent corrections, independent reviews, clear source attribution, and human editorial review of any AI-assisted work.'},copyright:{title:'Copyright & Takedown Policy',intro:'This template describes an owner-configured process for copyright queries and takedown requests.'}} as const;
export async function getStaticPaths(){return ['privacy','cookies','terms','editorial-policy','copyright'].map(legal=>({params:{legal}}));} const legal=Astro.params.legal as keyof typeof documents; const doc=documents[legal];
---
<BaseLayout title={`${doc.title} | Red Reactions`} description={doc.intro}><section class="wrap max-w-3xl py-12"><p class="eyebrow">Legal & editorial</p><h1 class="display mt-2 text-5xl">{doc.title}</h1><div class="prose mt-8"><p>{doc.intro}</p><h2>Before publication</h2><p><strong>TODO for owner:</strong> add the legal entity (if any), jurisdiction, effective date, contact details, exact data processors, analytics, advertising vendors, retention periods and rights process. Obtain qualified legal review where appropriate.</p><h2>Our approach</h2><p>Red Reactions covers culture through news, criticism, commentary and analysis. It does not host or distribute full copyrighted films, episodes, comics, manga, trailers, or downloads.</p><h2>Contact</h2><p>For policy questions, use the contact details shown on the Contact page after they have been configured by the site owner.</p></div></section></BaseLayout>
