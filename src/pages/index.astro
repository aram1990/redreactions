---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getPublishedArticles, articlePath } from '../lib/articles';
import { site } from '../config/site';
import { isReview } from '../lib/reviews';

const articles = await getPublishedArticles();
const featured = articles.filter(a => a.data.featured);
const newsArticles = articles.filter(a => a.data.contentType === 'news');
const newsLead = newsArticles[0] || articles[0];
const secondaryNews = newsArticles.filter(a => a.id !== newsLead?.id).slice(0, 5);
const trending = articles.filter(a => a.data.trending);
const trendingStories = trending.filter(a => a.id !== newsLead?.id);
const byType = (type: string) => articles.filter(a => a.data.contentType === type);
const reviews = articles.filter(a => isReview(a.data.rating));
const mustRead = (featured.length ? featured : articles.filter(a => a.data.contentType === 'feature' || a.data.contentType === 'lore'))
  .filter(a => a.id !== newsLead?.id && a.data.contentType !== 'news')
  .slice(0, 4);
const byTopic = (topic: string) => articles.filter(a => a.data.topics.includes(topic as never));
const universes = ['movies', 'tv', 'anime', 'gaming', 'comics'].map(topic => ({ topic, articles: byTopic(topic) })).filter(group => group.articles.length > 0);
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.description, publisher: { '@type': 'Organization', name: site.name } };
---
<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description} jsonLd={ld}>
  {trending.length > 0 && <section class="border-b border-line bg-panel"><div class="wrap flex gap-3 overflow-auto py-3 text-xs font-bold uppercase tracking-wider"><span class="text-red">Breaking</span>{trending.slice(0,3).map(a => <a class="whitespace-nowrap" href={articlePath(a)}>{a.data.title}</a>)}</div></section>}
  {newsLead && <section class="wrap py-8 md:py-12"><SectionHeading title="Latest News" href="/news/" label="All news" /><ArticleCard article={newsLead} variant="hero" showNewsBadge />{secondaryNews.length > 0 && <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{secondaryNews.map(a => <ArticleCard article={a} showNewsBadge />)}</div>}</section>}
  {trendingStories.length > 0 && <section class="wrap py-8"><SectionHeading title="Trending Now" /><div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">{trendingStories.map(a => <ArticleCard article={a} variant="compact" />)}</div></section>}
  {mustRead.length > 0 && <section class="wrap py-8"><SectionHeading title="Featured & Must Read" /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{mustRead.map(a => <ArticleCard article={a} />)}</div></section>}
  {reviews.length > 0 && <section class="wrap py-8"><SectionHeading title="Reviews" href="/reviews/" /><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{reviews.slice(0,3).map(a => <ArticleCard article={a} variant="review" />)}</div></section>}
  {(byType('reaction').length > 0 || byType('trailer').length > 0) && <section class="wrap py-8"><SectionHeading title="Reactions & Trailers" href="/reactions/" /><div class="grid gap-4 md:grid-cols-2">{[...byType('reaction'), ...byType('trailer')].map(a => <ArticleCard article={a} variant="video" />)}</div></section>}
  {universes.length > 0 && <section class="wrap py-8"><SectionHeading title="By Universe" /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{universes.map(({ topic, articles: topicArticles }) => <div class="card p-5"><p class="eyebrow">{topic === 'tv' ? 'TV & Streaming' : topic}</p><h2 class="display mt-3 text-2xl">{topic}</h2><div class="mt-4 space-y-3">{topicArticles.slice(0,2).map(a => <a class="block text-sm font-bold" href={articlePath(a)}>{a.data.title}</a>)}</div></div>)}</div></section>}
  <section class="mt-10 border-y border-line bg-panel py-12"><div class="wrap grid gap-5 md:grid-cols-[1fr_auto] md:items-end"><div><p class="eyebrow">Coming soon</p><h2 class="display mt-2 text-4xl">The no-filter newsletter</h2><p class="mt-2 text-muted">A future editorial newsletter. Connect an approved provider before enabling signups.</p></div><a class="w-fit bg-red px-5 py-3 text-sm font-bold uppercase tracking-wide text-white hover:bg-[#c90711] hover:text-white" href="/contact/">Get in touch</a></div></section>
</BaseLayout>
