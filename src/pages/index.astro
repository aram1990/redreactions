---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/cards/ArticleCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { getPublishedArticles, articlePath } from '../lib/articles';
import { site } from '../config/site';
import { isReview } from '../lib/reviews';

const articles = await getPublishedArticles();
const newsArticles = articles.filter(a => a.data.contentType === 'news');
// Fresh first: the hero is always the newest published NewsArticle (articles are already sorted
// newest-first). `featured` intentionally does not override this, so no story stays pinned once
// something newer publishes — it only affects the separate "Featured & Must Read" section below.
const newsLead = newsArticles[0] || articles[0];
const secondaryNews = newsArticles.filter(a => a.id !== newsLead?.id).slice(0, 6);
const trending = articles.filter(a => a.data.trending);
const trendingStories = trending.filter(a => a.id !== newsLead?.id);
const loreArticles = articles.filter(a => a.data.contentType === 'lore');
const byType = (type: string) => articles.filter(a => a.data.contentType === type);
const reviews = articles.filter(a => isReview(a.data.rating));
const mustRead = articles.filter(a => a.data.featured || a.data.contentType === 'feature')
  .filter(a => a.id !== newsLead?.id && a.data.contentType !== 'news')
  .slice(0, 4);
const byTopic = (topic: string) => articles.filter(a => a.data.topics.includes(topic as never));
const universes = ['movies', 'tv', 'anime', 'gaming', 'comics'].map(topic => ({ topic, label: topic === 'tv' ? 'TV & Streaming' : `${topic.charAt(0).toUpperCase()}${topic.slice(1)}`, articles: byTopic(topic) })).filter(group => group.articles.length > 0);
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: site.description, publisher: { '@type': 'Organization', name: site.name } };
---
<BaseLayout title={`${site.name} — ${site.tagline}`} description={site.description} jsonLd={ld}>
  {trending.length > 0 && <section class="border-b border-line bg-panel"><div class="wrap flex gap-3 overflow-auto py-3 text-xs font-bold uppercase tracking-wider"><span class="text-red">Breaking</span>{trending.slice(0,3).map(a => <a class="whitespace-nowrap" href={articlePath(a)}>{a.data.title}</a>)}</div></section>}
  {newsLead && <section class="wrap py-8 md:py-12"><h1 class="display mb-4 text-2xl sm:text-3xl">Red Reactions — Entertainment News, Reviews & Lore</h1><SectionHeading title="Latest News" href="/news/" label="All news" /><ArticleCard article={newsLead} variant="hero" showNewsBadge headingLevel="h3" />{secondaryNews.length > 0 && <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{secondaryNews.map(a => <ArticleCard article={a} showNewsBadge headingLevel="h3" />)}</div>}</section>}
  {trendingStories.length > 0 && <section class="wrap py-8"><SectionHeading title="Trending Now" /><div class="grid gap-3 md:grid-cols-2 lg:grid-cols-4">{trendingStories.map(a => <ArticleCard article={a} variant="compact" headingLevel="h3" />)}</div></section>}
  {loreArticles.length > 0 && <section class="wrap py-8"><SectionHeading title="Lore & Explained" href="/lore/" label="All Lore" /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{loreArticles.slice(0,4).map(a => <ArticleCard article={a} headingLevel="h3" />)}</div></section>}
  {mustRead.length > 0 && <section class="wrap py-8"><SectionHeading title="Featured & Must Read" /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{mustRead.map(a => <ArticleCard article={a} headingLevel="h3" />)}</div></section>}
  {reviews.length > 0 && <section class="wrap py-8"><SectionHeading title="Reviews" href="/reviews/" /><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{reviews.slice(0,3).map(a => <ArticleCard article={a} variant="review" headingLevel="h3" />)}</div></section>}
  {byType('trailer').length > 0 && <section class="wrap py-8"><SectionHeading title="Trailers" href="/trailers/" /><div class="grid gap-4 md:grid-cols-2">{byType('trailer').map(a => <ArticleCard article={a} variant="video" headingLevel="h3" />)}</div></section>}
  {universes.length > 0 && <section class="wrap py-8"><SectionHeading title="By Universe" /><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">{universes.map(({ label, articles: topicArticles }) => <div class="card p-5"><p class="eyebrow">Universe</p><h3 class="display mt-3 text-2xl">{label}</h3><div class="mt-4 space-y-3">{topicArticles.slice(0,2).map(a => <a class="block text-sm font-bold" href={articlePath(a)}>{a.data.title}</a>)}</div></div>)}</div></section>}
</BaseLayout>
