---
import BaseLayout from '../layouts/BaseLayout.astro'; import { getPublishedArticles, articlePath } from '../lib/articles'; const articles=await getPublishedArticles(); const index=articles.map(a=>({title:a.data.title,description:a.data.description,tags:a.data.tags,franchise:a.data.franchise,topics:a.data.topics,url:articlePath(a)}));
---
<BaseLayout title="Search | Red Reactions" description="Search Red Reactions coverage."><section class="wrap py-10"><p class="eyebrow">Find the signal</p><h1 class="display mt-2 text-5xl">Search</h1><label class="sr-only" for="site-search">Search articles</label><input id="site-search" class="mt-6 w-full border border-line bg-white px-4 py-4 text-lg text-paper shadow-sm placeholder:text-muted focus:border-red" placeholder="Search titles, tags, franchises and topics" autocomplete="off" /><div id="results" class="mt-6 grid gap-3"></div></section><script is:inline define:vars={{index}}>const input=document.querySelector('#site-search'); const results=document.querySelector('#results'); function render(){const query=input.value.trim().toLowerCase();const matches=query?index.filter(item=>[item.title,item.description,item.franchise,...item.tags,...item.topics].filter(Boolean).join(' ').toLowerCase().includes(query)):[];results.innerHTML=query?(matches.length?matches.map(item=>`<a class="card block p-4" href="${item.url}"><span class="eyebrow">${item.topics.join(' / ')}</span><b class="mt-2 block">${item.title}</b><span class="mt-1 block text-sm text-[#5f6368]">${item.description}</span></a>`).join(''):'<p class="text-[#5f6368]">No matching published articles.</p>'):'';} input.addEventListener('input',render);</script></BaseLayout>
