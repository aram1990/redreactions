---
import BaseLayout from '../layouts/BaseLayout.astro'; import { getPublishedArticles, articlePath } from '../lib/articles'; const articles=await getPublishedArticles(); const index=articles.map(a=>({title:a.data.title,description:a.data.description,tags:a.data.tags,franchise:a.data.franchise,topics:a.data.topics,url:articlePath(a)}));
---
<BaseLayout title="Search | Red Reactions" description="Search Red Reactions coverage." noindex><section class="wrap py-10"><p class="eyebrow">Find the signal</p><h1 class="display mt-2 text-5xl">Search</h1><label class="sr-only" for="site-search">Search articles</label><input id="site-search" class="mt-6 w-full border border-line bg-white px-4 py-4 text-lg text-paper shadow-sm placeholder:text-muted focus:border-red" placeholder="Search titles, tags, franchises and topics" autocomplete="off" /><div id="results" class="mt-6 grid gap-3"></div></section><script is:inline define:vars={{index}}>const input=document.querySelector('#site-search'); const results=document.querySelector('#results'); function clear(el){while(el.firstChild)el.removeChild(el.firstChild);} function render(){const query=input.value.trim().toLowerCase();const matches=query?index.filter(item=>[item.title,item.description,item.franchise,...item.tags,...item.topics].filter(Boolean).join(' ').toLowerCase().includes(query)):[];clear(results);if(!query)return;if(!matches.length){const p=document.createElement('p');p.className='text-[#5f6368]';p.textContent='No matching published articles.';results.appendChild(p);return;}matches.forEach(item=>{const a=document.createElement('a');a.className='card block p-4';a.href=item.url;const eyebrow=document.createElement('span');eyebrow.className='eyebrow';eyebrow.textContent=item.topics.join(' / ');const title=document.createElement('b');title.className='mt-2 block';title.textContent=item.title;const desc=document.createElement('span');desc.className='mt-1 block text-sm text-[#5f6368]';desc.textContent=item.description;a.append(eyebrow,title,desc);results.appendChild(a);});} input.addEventListener('input',render);</script></BaseLayout>
