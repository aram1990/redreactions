---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/cards/ArticleCard.astro';
import { authorSlug, getPublishedArticles, type Article } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return [...new Set(articles.map(article => article.data.author))].map(author => ({
    params: { slug: authorSlug(author) },
    props: { author, articles: articles.filter(article => article.data.author === author) },
  }));
}

const { author, articles } = Astro.props as { author: string; articles: Article[] };
---
<BaseLayout title={`${author} | Red Reactions`} description={`Articles by ${author} at Red Reactions.`}>
  <section class="wrap py-12 md:py-16">
    <p class="eyebrow">Our Writers</p>
    <h1 class="display mt-2 text-5xl sm:text-6xl">{author}</h1>
    <p class="mt-3 text-sm text-muted">{articles.length} {articles.length === 1 ? 'published article' : 'published articles'}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {articles.map(article => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
