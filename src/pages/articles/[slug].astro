---
import ArticleLayout from '../../layouts/ArticleLayout.astro'; import { getPublishedArticles, relatedTo, scopedNeighbors, articleSlug } from '../../lib/articles'; import { render } from 'astro:content';
export async function getStaticPaths() { const articles=await getPublishedArticles(); return articles.map((article,index)=>({params:{slug:articleSlug(article)},props:{article,all:articles,index}})); }
const {article,all}=Astro.props; const {Content,headings}=await render(article);
const {previous,next} = scopedNeighbors(article, all);
---
<ArticleLayout {article} {headings} related={relatedTo(article,all)} {previous} {next}><Content /></ArticleLayout>
