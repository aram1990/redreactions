---
import BaseLayout from '../layouts/BaseLayout.astro'; import { site } from '../config/site';
const contactTopics = [
  ['General', 'General inquiry'],
  ['Editorial', 'Editorial inquiry'],
  ['Corrections', 'Correction request'],
  ['Copyright / takedown', 'Copyright or takedown request'],
  ['Business', 'Business inquiry'],
] as const;
---
<BaseLayout title="Contact | Red Reactions" description="Contact Red Reactions by email."><section class="wrap max-w-3xl py-12"><p class="eyebrow">Contact</p><h1 class="display mt-2 text-5xl">Start a conversation</h1><p class="mt-4 max-w-2xl text-muted">Red Reactions is available by email. Select a topic below to start a message; every inquiry reaches the same monitored inbox.</p><div class="mt-8 grid gap-4 sm:grid-cols-2">{contactTopics.map(([label, subject])=><a class="card p-5" href={`mailto:${site.contactEmail}?subject=${encodeURIComponent(subject)}`}><span class="eyebrow">{label}</span><b class="mt-2 block break-all">{site.contactEmail}</b></a>)}</div><p class="mt-6 text-sm text-muted">This site does not use a contact form.</p></section></BaseLayout>
