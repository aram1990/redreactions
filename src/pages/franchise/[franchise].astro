---
import CategoryLayout from '../../layouts/CategoryLayout.astro'; import { franchiseLabel, franchiseSlug, getPublishedArticles } from '../../lib/articles';
import { groupByCoverageType, MIN_INDEXABLE } from '../../lib/taxonomy';
export async function getStaticPaths(){const all=await getPublishedArticles();const names=[...new Set(all.map(a=>a.data.franchise).filter(Boolean) as string[])];return names.map(franchise=>({params:{franchise:franchiseSlug(franchise)},props:{franchise,articles:all.filter(a=>a.data.franchise===franchise)}}));} const {franchise,articles}=Astro.props;
const sections = groupByCoverageType(articles).map(c => ({ label: c.label, articles: c.articles }));
---
<CategoryLayout title={franchiseLabel(franchise)} description={`News, reviews, reactions and lore from the ${franchiseLabel(franchise)} universe.`} {articles} {sections} noindex={articles.length < MIN_INDEXABLE} />
