---
import CategoryLayout from '../../layouts/CategoryLayout.astro'; import { articlePath, franchiseLabel, franchisePath, franchiseSlug, getPublishedArticles } from '../../lib/articles';
import { groupByCoverageType, MIN_INDEXABLE } from '../../lib/taxonomy';
import { getFranchiseHubContent } from '../../config/franchiseHubs';
import { site } from '../../config/site';
export async function getStaticPaths(){const all=await getPublishedArticles();const names=[...new Set(all.map(a=>a.data.franchise).filter(Boolean) as string[])];return names.map(franchise=>({params:{franchise:franchiseSlug(franchise)},props:{franchise,articles:all.filter(a=>a.data.franchise===franchise)}}));} const {franchise,articles}=Astro.props;
const sections = groupByCoverageType(articles).map(c => ({ label: c.label, articles: c.articles }));
const label = franchiseLabel(franchise);
const noindex = articles.length < MIN_INDEXABLE;
// Optional hand-written hub content only renders once real matching articles exist — a stale or
// mistyped slug in the config just quietly drops out rather than producing a dead link.
const rawHub = noindex ? undefined : getFranchiseHubContent(franchise);
const findBySlug = (slug: string) => articles.find(a => articlePath(a) === `/articles/${slug}/`);
const hub = rawHub ? {
  intro: rawHub.intro,
  whereToStart: findBySlug(rawHub.whereToStartSlug),
  readingOrder: rawHub.readingOrderSlugs.map(findBySlug).filter((a): a is typeof articles[number] => Boolean(a)),
} : undefined;
const hubUrl = new URL(franchisePath(franchise), site.url).href;
// Indexable hubs only: a noindex 1-2 article archive shouldn't advertise itself as a real
// collection. Reuses the same @graph + BreadcrumbList shape ArticleLayout already emits.
const jsonLd = noindex ? undefined : {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: label,
      url: hubUrl,
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: articles.length,
        itemListElement: articles.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(articlePath(a), site.url).href })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
        { '@type': 'ListItem', position: 2, name: label, item: hubUrl },
      ],
    },
  ],
};
const description = hub?.intro ?? `News, reviews, reactions and lore from the ${label} universe.`;
---
<CategoryLayout title={label} {description} {articles} {sections} {noindex} {jsonLd} {hub} />
