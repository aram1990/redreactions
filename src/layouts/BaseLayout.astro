---
import '../styles/global.css'; import Header from '../components/layout/Header.astro'; import Footer from '../components/layout/Footer.astro'; import SEO from '../components/seo/SEO.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; jsonLd?: Record<string, unknown>; disableAds?: boolean; disableAnalytics?: boolean; }
const { title, description, image, noindex, jsonLd, disableAds = false, disableAnalytics = false } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><link rel="icon" href="/favicon.ico" sizes="any" /><link rel="icon" type="image/png" sizes="48x48" href="/images/Logo/favicon-48x48.png" /><link rel="icon" type="image/png" sizes="32x32" href="/images/Logo/favicon-32x32.png" /><link rel="icon" type="image/png" sizes="16x16" href="/images/Logo/favicon-16x16.png" /><link rel="apple-touch-icon" sizes="180x180" href="/images/Logo/apple-touch-icon.png" /><SEO {title} {description} {image} {noindex} {jsonLd} />{!disableAnalytics && <><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-K6XBXKY2K9"></script><script is:inline>{`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
  ad_storage: 'denied',
  ad_user_data: 'denied',
  ad_personalization: 'denied',
  analytics_storage: 'denied',
  wait_for_update: 500
});
gtag('js', new Date());
gtag('config', 'G-K6XBXKY2K9');`}</script></>}{!disableAds && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2390350333397010" crossorigin="anonymous"></script>}</head><body><Header /><main id="main"><slot /></main><Footer /></body></html>
