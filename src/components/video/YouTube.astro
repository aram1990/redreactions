---
interface Props { id: string; title?: string; } const { id, title = 'YouTube video' } = Astro.props;
---
<div class="my-8 aspect-video overflow-hidden border border-line bg-panel"><iframe class="h-full w-full" src={`https://www.youtube-nocookie.com/embed/${id}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
