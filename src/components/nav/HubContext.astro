---
// Drop into any browse/index page. Records "the hub the reader actually clicked an
// article from" in same-origin sessionStorage, so article pages can render an accurate
// contextual back link. The context is written only when an article link on this page
// is clicked — not merely on page view — so simply passing through a hub (e.g. Marvel)
// without clicking anything can never leak stale context into a later, unrelated visit.
// Never uses query params and never touches other origins.
interface Props { label: string; href?: string; }
const { label, href = Astro.url.pathname } = Astro.props;
---
<script is:inline define:vars={{ label, href }}>
  document.addEventListener('click', function (event) {
    var target = event.target;
    var link = target && target.closest ? target.closest('a[href^="/articles/"]') : null;
    if (!link) return;
    try { sessionStorage.setItem('rr:hub', JSON.stringify({ label: label, href: href })); } catch { /* sessionStorage unavailable */ }
  });
</script>
