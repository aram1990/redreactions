---
interface Props { score: number; } const {score} = Astro.props;
---
<aside class="my-8 flex w-fit items-center gap-4 border-l-4 border-red bg-[#181818] px-5 py-4 text-white"><span class="eyebrow">Red Score</span><strong class="display text-4xl text-red">{score}<small class="text-lg text-white"> / 10</small></strong></aside>
