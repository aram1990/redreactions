---
import { navItems, site } from '../../config/site';
---
<footer class="mt-20 border-t border-[#181818] bg-[#111111] py-14 text-white"><div class="wrap grid gap-10 md:grid-cols-[1.3fr_2fr]">
<div><div class="display text-3xl">RED <span class="text-red">REACTIONS</span></div><p class="mt-3 max-w-xs text-sm text-zinc-400">{site.tagline}</p><div class="mt-5 flex gap-3 text-xs font-bold uppercase">{Object.entries(site.social).map(([name,url]) => <a href={url} rel="noopener noreferrer" target="_blank">{name}</a>)}</div></div>
<div class="grid grid-cols-2 gap-6 sm:grid-cols-3"><div><p class="eyebrow mb-3">Explore</p>{navItems.slice(0,5).map(([l,h])=><a class="mb-2 block text-sm" href={h}>{l}</a>)}</div><div><p class="eyebrow mb-3">Editorial</p>{navItems.slice(5).map(([l,h])=><a class="mb-2 block text-sm" href={h}>{l}</a>)}</div><div><p class="eyebrow mb-3">Company</p>{[['About','/about/'],['Contact','/contact/'],['Editorial Policy','/editorial-policy/'],['Privacy','/privacy/'],['Cookies','/cookies/'],['Terms','/terms/'],['Copyright','/copyright/']].map(([l,h])=><a class="mb-2 block text-sm" href={h}>{l}</a>)}</div></div>
</div><div class="wrap mt-12 border-t border-zinc-800 pt-5 text-xs text-zinc-400">© {new Date().getFullYear()} Red Reactions. All rights reserved.</div></footer>
