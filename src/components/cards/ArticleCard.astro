---
import type { Article } from '../../lib/articles'; import { articlePath, articleSlug } from '../../lib/articles';
import responsiveManifest from '../../data/responsive-images.json';
interface Props { article: Article; variant?: 'hero'|'large'|'standard'|'compact'|'horizontal'|'video'|'review'; showNewsBadge?: boolean; headingLevel?: 'h2'|'h3'|'h4'; }
const { article, variant = 'standard', showNewsBadge = false, headingLevel = 'h2' } = Astro.props; const { data } = article; const path = articlePath(article); const isHero = variant === 'hero'; const horizontal = variant === 'horizontal' || variant === 'compact'; const Heading = headingLevel;
// Phase 1 pilot: only articles present in the generated manifest (see scripts/generate-responsive-images.mjs)
// get a srcset. Everything else renders the exact same plain <img> as before -- no article is required
// to have derivatives, and the canonical heroImage (OG/Twitter/ArticleLayout) is never touched here.
const responsive = (responsiveManifest as Record<string, { widths: number[] }>)[articleSlug(article)];
const slug = articleSlug(article);
const srcset = responsive ? responsive.widths.map(w => `/images/responsive/articles/${slug}/${w}.webp ${w}w`).join(', ') : undefined;
// Truthful to this site's actual grid breakpoints (sm:grid-cols-2, lg:grid-cols-3 is the most common
// standard-card pattern across the homepage and CategoryLayout) inside the max-1440px .wrap container.
const sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
---
<article class:list={['group overflow-hidden card', horizontal && 'grid grid-cols-[130px_1fr]', isHero && 'md:grid md:grid-cols-[1.4fr_1fr]']}>
 <a class:list={[horizontal ? 'aspect-square' : 'aspect-[16/9]', 'block overflow-hidden bg-panel', isHero && 'md:aspect-auto md:min-h-[430px]', !horizontal && data.heroImageAspect === 'portrait' && 'card-image--portrait']} href={path}><img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={data.heroImage} srcset={srcset} sizes={srcset ? sizes : undefined} alt={data.heroImageAlt} width="1600" height="900" loading={isHero ? 'eager':'lazy'} style={data.heroImagePosition ? `object-position: ${data.heroImagePosition}` : undefined} /></a>
 <div class:list={["p-4", isHero && 'flex flex-col justify-end p-6 md:p-9']}><div class="flex items-center gap-2"><span class="eyebrow">{data.contentType}</span>{showNewsBadge && data.contentType === 'news' && <span class="bg-[#181818] px-1.5 py-0.5 text-[.58rem] font-extrabold uppercase tracking-[.1em] text-white">News</span>}{data.spoilers && <span class="text-[.62rem] font-bold uppercase text-amber-700">Spoilers</span>}</div><Heading class:list={["mt-2 font-bold leading-tight text-paper", isHero ? 'display text-3xl md:text-5xl' : 'text-lg', horizontal && 'text-sm sm:text-base']}><a href={path}>{data.title}</a></Heading>{!horizontal && <p class="mt-2 text-sm leading-relaxed text-muted">{data.description}</p>}<div class="mt-3 flex items-center gap-2 text-xs text-muted"><time datetime={data.publishedAt.toISOString()}>{data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time>{variant === 'review' && data.rating && <span class="ml-auto font-bold text-red">RED {data.rating}/10</span>}{data.youtubeId && <span class="ml-auto text-red">▶ VIDEO</span>}</div></div>
</article>

<style>
  @media (max-width: 767px) { .card-image--portrait { aspect-ratio: 3 / 4; } }
</style>
