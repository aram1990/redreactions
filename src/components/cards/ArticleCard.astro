---
import type { Article } from '../../lib/articles'; import { articlePath } from '../../lib/articles';
interface Props { article: Article; variant?: 'hero'|'large'|'standard'|'compact'|'horizontal'|'video'|'review'; }
const { article, variant = 'standard' } = Astro.props; const { data } = article; const path = articlePath(article); const isHero = variant === 'hero'; const horizontal = variant === 'horizontal' || variant === 'compact';
---
<article class:list={['group overflow-hidden card', horizontal && 'grid grid-cols-[130px_1fr]', isHero && 'md:grid md:grid-cols-[1.4fr_1fr]']}>
 <a class:list={[horizontal ? 'aspect-square' : 'aspect-[16/9]', 'block overflow-hidden bg-panel', isHero && 'md:aspect-auto md:min-h-[430px]']} href={path}><img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={data.heroImage} alt={data.heroImageAlt} width="1600" height="900" loading={isHero ? 'eager':'lazy'} /></a>
 <div class:list={["p-4", isHero && 'flex flex-col justify-end p-6 md:p-9']}><div class="flex items-center gap-2"><span class="eyebrow">{data.contentType}</span>{data.spoilers && <span class="text-[.62rem] font-bold uppercase text-amber-700">Spoilers</span>}</div><h2 class:list={["mt-2 font-bold leading-tight text-paper", isHero ? 'display text-3xl md:text-5xl' : 'text-lg', horizontal && 'text-sm sm:text-base']}><a href={path}>{data.title}</a></h2>{!horizontal && <p class="mt-2 text-sm leading-relaxed text-muted">{data.description}</p>}<div class="mt-3 flex items-center gap-2 text-xs text-muted"><time datetime={data.publishedAt.toISOString()}>{data.publishedAt.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</time>{variant === 'review' && data.rating && <span class="ml-auto font-bold text-red">RED {data.rating}/10</span>}{data.youtubeId && <span class="ml-auto text-red">▶ VIDEO</span>}</div></div>
</article>
