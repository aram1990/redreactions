---
import type { Article } from '../../lib/articles';
import { articlePath } from '../../lib/articles';
import { reviewTopicLabel } from '../../lib/reviews';
import ReviewScore from '../review/ReviewScore.astro';
interface Props { article: Article; featured?: boolean; }
const { article, featured = false } = Astro.props;
const { data } = article;
const path = articlePath(article);
const rating = data.rating!;
---
<article class:list={["group overflow-hidden border border-line bg-white shadow-sm", featured && 'lg:grid lg:grid-cols-[1.35fr_1fr]']}>
  <a class:list={["block overflow-hidden bg-panel", featured ? 'aspect-[16/10] lg:aspect-auto lg:min-h-[410px]' : 'aspect-video']} href={path}><img class="h-full w-full object-cover transition duration-500 group-hover:scale-105" src={data.heroImage} alt={data.heroImageAlt} width="1600" height="900" loading={featured ? 'eager' : 'lazy'} /></a>
  <div class:list={["p-5", featured && 'flex flex-col justify-end p-6 md:p-9']}>
    <div class="flex flex-wrap items-center gap-2"><span class="eyebrow">{reviewTopicLabel(data.topics[0]!)} Review</span>{data.spoilerLevel && <span class="border border-amber-400 bg-amber-50 px-2 py-1 text-[.62rem] font-extrabold uppercase tracking-[.1em] text-amber-900">{data.spoilerLevel}</span>}</div>
    <h2 class:list={["mt-3 font-bold leading-tight text-paper", featured ? 'display text-3xl md:text-5xl' : 'text-xl']}><a href={path}>{data.title}</a></h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{data.description}</p>
    <ReviewScore rating={rating} compact />
  </div>
</article>
